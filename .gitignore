# 它已入库；这些原始件体积大、文件名带括号与全角标点，留在本地即可。
*.mp3

# 与本项目无关的本机网卡配置导出
network-backup/

# Local models and video sources
*.pt
*.mp4
*.avi
*.mov
*.mkv
*.flv
*.wmv

# IDE files
.idea/
.vscode/

# PyInstaller 打包中间产物与发布目录（spec / build.ps1 本身要入库）
execode/build/
execode/dist/
execode/stage/

# 历史发布包的留档。一个包 300 MB 上下，进了 git 历史就再也清不干净 ——
# 它和 dist/ 一样属于产物，留在本地即可。
execode/release-backup/
